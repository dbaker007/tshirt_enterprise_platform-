{
  "type": "record",
  "name": "SagaReply",
  "namespace": "com.tshirt.sales",
  "doc": "Standardized data contract for workers to report task outcomes back to the conductor.",
  "fields": [
    { "name": "order_id", "type": "string", "doc": "The master transaction tracking UUID string" },
    { "name": "department", "type": "string", "doc": "The reporting department signature token (e.g., FINANCE or SHIPPING)" },
    { "name": "status", "type": "string", "doc": "The outcome state flag string (e.g., SUCCESS or FAILED)" },
    { "name": "ledger_status", "type": "string", "doc": "Descriptive status tracking semantic milestone states" },
    { "name": "timestamp", "type": "string", "doc": "ISO-8601 string tracking when the worker saved the record" }
  ]
}
