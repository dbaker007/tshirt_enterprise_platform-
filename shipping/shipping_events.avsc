{
  "type": "record",
  "name": "ShippingEvent",
  "namespace": "com.tshirt.shipping",
  "doc": "Data contract for downstream shipping logistics and fulfillment milestones.",
  "fields": [
    { "name": "order_id", "type": "string", "doc": "Globally unique tracking UUID string mapping back to initial sales record" },
    { "name": "status", "type": "string", "doc": "The specific logistics milestone state flag (e.g. SHIPMENT_SECURED)" },
    { "name": "timestamp", "type": "string", "doc": "ISO-8601 string payload tracking database persistence time" }
  ]
}
